# Supabase Postgres connection string — used only by database/db.py's
# init_db() to run CREATE TABLE DDL, since Supabase's REST API (what the
# supabase-py client below talks to) cannot execute DDL at all.
# Use the "Transaction" pooler connection (port 6543), not the direct
# connection (port 5432) — this app opens a new connection per call
# with no connection pooling of its own, and the pooler is built for that.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# Supabase project URL and API key, used by the supabase-py client for
# all non-DDL reads/writes (seed_db and every route in app.py) and for
# admin-only Auth calls (auth.admin.create_user in seed_db).
# SUPABASE_KEY must be the service_role SECRET key (Project Settings ->
# API Keys -> service_role/secret), not the publishable key — it bypasses
# Row Level Security, appropriate since this is a trusted backend. Treat
# it like a password: never commit the real .env, never send this key to
# a browser/client.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-service-role-secret-key

# Publishable key, used ONLY for end-user auth (sign_up / sign_in_with_password
# in app.py's register()/login()). Unlike SUPABASE_KEY, this key is safe by
# Supabase's own design to be non-secret — but never reuse the client built
# from it for .table() calls, since a successful sign_up/sign_in rebinds
# that client to the signed-in user's session (see get_auth_client() in
# database/db.py).
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
